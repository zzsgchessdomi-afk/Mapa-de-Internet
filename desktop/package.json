{
  "name": "atlanex-desktop",
  "version": "30.0.0",
  "description": "ATLANEX Autonomous Research OS for Windows",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "prepare:app": "node scripts/prepare_app.mjs",
    "start": "npm run prepare:app && electron .",
    "check": "node --check main.js && node --check preload.cjs && node --check scripts/prepare_app.mjs",
    "dist:win": "npm run prepare:app && electron-builder --win nsis portable --x64",
    "dist": "npm run prepare:app && electron-builder"
  },
  "devDependencies": {
    "electron": "38.2.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.atlanex.researchos",
    "productName": "ATLANEX",
    "files": [
      "main.js",
      "preload.cjs",
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "perMachine": false,
      "allowElevation": true,
      "shortcutName": "ATLANEX",
      "deleteAppDataOnUninstall": false,
      "artifactName": "ATLANEX-Setup-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "bundled-agent-engine",
        "to": "agent-engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "portable": {
      "artifactName": "ATLANEX-Portable-${version}-${arch}.${ext}"
    },
    "artifactName": "ATLANEX-${version}-${arch}.${ext}"
  },
  "dependencies": {
    "pdf-parse": "2.4.5"
  }
}
