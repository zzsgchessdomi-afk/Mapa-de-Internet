+    @staticmethod
+    def _require_ok(result: dict[str, Any], operation: str) -> dict[str, Any]:
+        if not result.get("ok"):
+            raise RuntimeError(result.get("error") or f"{operation} falló")
+        data = result.get("data")
+        return data if isinstance(data, dict) else {}
+
+    async def push_file(self, relay: str, peer_id: str, file_path: str | Path, progress=None) -> dict[str, Any]:
+        path = Path(file_path)
+        if not path.is_file():
+            raise FileNotFoundError(path)
+        size = path.stat().st_size
+        if size > 8 * 1024 * 1024:
+            raise ValueError("La transferencia directa actual admite archivos de hasta 8 MiB")
+        digest = hashlib.sha256()
+        with path.open("rb") as fh:
+            for block in iter(lambda: fh.read(1024 * 1024), b""):
+                digest.update(block)
+        sha = digest.hexdigest()
+        transfer_id = uuid.uuid4().hex
+        mime = mimetypes.guess_type(path.name)[0] or "application/octet-stream"
+        peer = self.trust.get(peer_id)
+        async with websockets.connect(relay) as ws:
+            await ws.send(self.registration())
+            sync = await self._command_ws(ws, peer, "jarvis.profile.sync", {
+                "assistant_id": self.assistant_id, "name": self.profile.get("name", "JARVIS"),
+                "created_at": self.profile.get("created_at", 0),
+            })
+            self._require_ok(sync, "Sincronización JARVIS")
+            begin = await self._command_ws(ws, peer, "file.push.begin", {
+                "transfer_id": transfer_id, "name": path.name, "size": size, "sha256": sha, "mime": mime,
+            })
+            begin_data = self._require_ok(begin, "Inicio de transferencia")
+            chunk_size = min(32768, max(1024, int(begin_data.get("max_chunk_bytes", 32768))))
+            sent = 0
+            index = 0
+            with path.open("rb") as fh:
+                while True:
+                    block = fh.read(chunk_size)
+                    if not block:
+                        break
+                    part = await self._command_ws(ws, peer, "file.push.chunk", {
+                        "transfer_id": transfer_id, "index": index,
+                        "data_b64": base64.urlsafe_b64encode(block).decode("ascii"),
+                    }, timeout=30)
+                    self._require_ok(part, f"Chunk {index}")
+                    sent += len(block)
+                    index += 1
+                    if progress:
+                        progress(sent, size)
+            commit = await self._command_ws(ws, peer, "file.push.commit", {"transfer_id": transfer_id}, timeout=30)
+            data = self._require_ok(commit, "Verificación final")
+            self.memory.event("file.sent", {"name": path.name, "bytes": size, "sha256": sha, "result": data}, peer_id)
+            return data
 
