+    async def _command_ws(self, ws, peer: Peer, capability: str, params: dict[str, Any], timeout: float = 15) -> dict[str, Any]:
+        packet, command_id = self.make_command(peer, capability, params)
+        await ws.send(packet)
+        deadline = asyncio.get_running_loop().time() + timeout
+        while True:
+            remain = deadline - asyncio.get_running_loop().time()
+            if remain <= 0:
+                raise TimeoutError(f"Sin respuesta para {command_id}")
+            raw = await asyncio.wait_for(ws.recv(), remain)
+            result = self.open_response(peer, raw, command_id)
+            if result is not None:
+                self.memory.event("device.result", {"capability": capability, "result": result}, peer.device_id)
+                return result
